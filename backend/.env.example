# Development values only. Never read in production; every variable is set in Railway there.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smarthotel
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CORS_ORIGINS=[]
STATIC_DIR=static
# Coupling with the Hotel OS (ADR-0007). Empty values switch the parts off.
HOTEL_OS_URL=
HOTEL_OS_USERNAME=
HOTEL_OS_PASSWORD=
HOTEL_OS_WEBHOOK_TOKEN=
HOTEL_OS_INBOX_KEY=
